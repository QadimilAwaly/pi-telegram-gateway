# =======================================================
# Pi Telegram Gateway Configuration
# =======================================================

# 1. Telegram Bot Token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 2. Security: Comma-separated list of allowed Telegram user IDs
# (Leave blank during first test to find your User ID, then set it!)
ALLOWED_USERS=

# 3. Default Model & Thinking Level (optional)
# If omitted, Pi automatically uses your ~/.pi/agent/settings.json default
DEFAULT_PROVIDER=antigravity
DEFAULT_MODEL=gemini-3.7-flash
DEFAULT_THINKING_LEVEL=high

# 4. Default working directory for Pi sessions (optional)
DEFAULT_CWD=/data/data/com.termux/files/home

# 5. Directory where Telegram session history is stored
SESSIONS_DIR=/data/data/com.termux/files/home/.pi/telegram-sessions
